/* ============================================================================
   Firestore Security Rules — Medical Department
   ============================================================================
   WICHTIG: Diese Datei hier ist nur eine ARCHIV-/VERSIONS-KOPIE. Sie wird
   NICHT automatisch von Firebase gelesen! Damit sie wirklich gilt, musst du
   sie manuell in der Firebase-Konsole einfügen:

     Firebase-Konsole -> dein Projekt -> Firestore Database -> Reiter
     "Regeln" -> kompletten bisherigen Inhalt löschen -> den Inhalt dieser
     Datei hier hineinkopieren -> "Veröffentlichen" klicken.

   Enthält: users/usernames/adminLog/presence (inkl. "unantastbar"-Schutz und
   Selbstheilungs-Mechanismus für befristete Sperren) sowie die Collections
   des Medical Department (patienten, akten, termine, dienst, freigaben,
   kataloge).
   Für alles andere gibt es keine Regel - der Zugriff ist dort verweigert.
   ============================================================================ */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------------
       Hilfsfunktionen
       ------------------------------------------------------------------ */

    // Ist überhaupt jemand eingeloggt (egal welcher Status)?
    function istEingeloggt() {
      return request.auth != null;
    }

    // Lädt das eigene users/{uid}-Dokument des gerade eingeloggten Kontos.
    // Wichtig: get() zählt NICHT als "list" - das ist erlaubt, auch wenn
    // man selbst (noch) gar keine Leserechte auf die users-Collection als
    // Ganzes hat.
    function eigenesUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Ist der eingeloggte Nutzer ein Admin (= technische Systemverwaltung)?
    // Unabhängig vom RP-Rang UND unabhängig von istLeitung().
    function istAdmin() {
      return istEingeloggt() && eigenesUserDoc().isAdmin == true;
    }

    // Ist der eingeloggte Nutzer Leitung (= RP-interne Departmentführung)?
    // Komplett unabhängig von istAdmin() - ein Admin ist NICHT automatisch
    // Leitung und umgekehrt, beide Felder werden getrennt vergeben (siehe
    // "isLeitung" in js/auth.js). .get(..., false) liefert für bestehende
    // Accounts ohne dieses Feld sicher "false" statt eines Fehlers.
    function istLeitung() {
      return istEingeloggt() && eigenesUserDoc().get('isLeitung', false) == true;
    }

    // Prüft, ob die EIGENE zeitlich befristete Sperre (falls vorhanden)
    // bereits abgelaufen ist. "gesperrtBis" ist ein Timestamp-Feld, das nur
    // bei einer befristeten (nicht dauerhaften) Sperre gesetzt wird.
    // request.time ist die von Firebase selbst ermittelte, vertrauenswürdige
    // Serverzeit - kann vom Client nicht gefälscht werden.
    function eigeneSperreAbgelaufen() {
      let eigene = eigenesUserDoc();
      return eigene.status == 'locked'
        && eigene.get('gesperrtBis', null) != null
        && request.time > eigene.gesperrtBis;
    }

    // Ist der eingeloggte Nutzer freigegeben? Zählt sowohl "approved" als
    // auch eine befristete Sperre, deren Zeit bereits abgelaufen ist - so
    // funktioniert die zeitliche Sperre auch OHNE eigenen Server/Cloud
    // Function, rein anhand der von Firebase selbst geprüften Uhrzeit.
    function istFreigegeben() {
      return istEingeloggt() && (eigenesUserDoc().status == 'approved' || eigeneSperreAbgelaufen());
    }

    // Ist DAS BETROFFENE Dokument (nicht der eingeloggte Nutzer, sondern
    // das Dokument, das gerade geändert werden soll) als "unantastbar"
    // markiert? Über resource.data.get(...) mit Standardwert false, damit
    // das für alle "normalen" Accounts ohne dieses Feld nicht crasht.
    function istUnantastbar() {
      return resource.data.get('geschuetzt', false) == true;
    }

    // Verhindert genau zwei Dinge bei einem "unantastbar" markierten
    // Account: dass ihm die Admin-/Verwalterrechte entzogen werden, oder
    // dass sein Status von "approved" weggeändert wird (z. B. Sperren/
    // Ablehnen). Alles andere (Rang ändern, Notiz setzen, Umbenennen)
    // bleibt für Verwalter ganz normal weiter möglich.
    function verletztUnantastbarkeit() {
      let geaenderteFelder = request.resource.data.diff(resource.data).affectedKeys();
      return istUnantastbar() &&
        (
          (geaenderteFelder.hasAny(['isAdmin']) && request.resource.data.isAdmin == false) ||
          (geaenderteFelder.hasAny(['status']) && request.resource.data.status != 'approved')
        );
    }

    /* ------------------------------------------------------------------
       users/{uid} — ein Dokument pro Account, Dokument-ID = Firebase-Auth-UID
       ------------------------------------------------------------------ */
    match /users/{uid} {
      // Einzelnes Dokument lesen: das eigene, oder wenn man Verwalter ODER
      // Leitung ist (Leitung braucht das für die Personalakte/Personal-Liste).
      allow get: if istEingeloggt() && (request.auth.uid == uid || istAdmin() || istLeitung());

      // Die GESAMTE Liste lesen (Benutzerverwaltung UND die Leitungs-
      // Personalliste nutzen dieselbe Collection): Verwalter oder Leitung.
      allow list: if istAdmin() || istLeitung();

      // Neuen Account anlegen: nur das eigene Dokument, und zwingend mit
      // status "pending", isAdmin false UND isLeitung false - so kann sich
      // niemand selbst sofort freischalten oder zum Verwalter/zur Leitung
      // machen, egal was das Frontend schickt.
      allow create: if istEingeloggt()
                    && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.isAdmin == false
                    && request.resource.data.isLeitung == false;

      // Ändern: Verwalter dürfen weiterhin ALLES ändern (Freigeben/Ablehnen/
      // Sperren/Verwalter-/Leitungsrechte/Notiz/Umbenennen/Rang) - AUSSER bei
      // einem als "geschuetzt: true" markierten Account darf selbst ein
      // Verwalter nicht die Verwalterrechte entziehen oder den Freigabe-
      // Status wegändern (siehe verletztUnantastbarkeit() oben; isLeitung
      // ist davon bewusst NICHT geschützt).
      //
      // NEU: Leitung (auch OHNE Adminrechte) darf ausschließlich das Feld
      // "rolle" ändern - der RP-Rang. hasOnly(['rolle']) ist bewusst eng
      // gefasst (kein hasAny!): Leitung kann damit niemals isAdmin,
      // isLeitung, status, gesperrtBis, geschuetzt, E-Mail oder andere
      // technische Accountdaten verändern, selbst wenn sie versucht würden,
      // im selben Schreibvorgang mitzuschicken - Firestore lehnt den
      // gesamten Schreibvorgang ab, sobald ein einziges anderes Feld
      // betroffen wäre.
      //
      // Unverändert: der Account selbst darf NUR sein eigenes "lastLogin"
      // aktualisieren, oder sich selbst von "locked" zurück auf "approved"
      // setzen, wenn die eigene befristete Sperre laut Server-Uhrzeit
      // bereits abgelaufen ist (Selbstheilungs-Mechanismus).
      //
      // VORBEREITET FÜR SPÄTER (Phase 4/5 der Rang-Migration, siehe Konzept,
      // NOCH NICHT aktiv): Sobald "users" auf ein Feld "rolleId" umgestellt
      // wird, muss der Leitungs-Zweig unten zusätzlich serverseitig prüfen,
      // dass der neu gesetzte Rang existiert und aktiv ist, z. B. durch
      // Ergänzen von:
      //   && get(/databases/$(database)/documents/raenge/$(request.resource.data.rolleId)).data.aktiv == true
      // Diese Prüfung ist bewusst noch NICHT eingebaut, weil Leitung aktuell
      // ausschließlich das Feld "rolle" (Freitext) schreibt, nicht "rolleId" -
      // eine Prüfung gegen "raenge" wäre hier heute wirkungslos und würde nur
      // unnötig einen zusätzlichen Lesevorgang pro Rangänderung kosten.
      allow update: if (istAdmin() && !verletztUnantastbarkeit())
                    || (istLeitung()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rolle']))
                    || (request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']))
                    || (request.auth.uid == uid
                        && resource.data.status == 'locked'
                        && resource.data.get('gesperrtBis', null) != null
                        && request.time > resource.data.gesperrtBis
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastLogin', 'gesperrtBis'])
                        && request.resource.data.status == 'approved');

      // Löschen: nur Verwalter, und niemals bei einem "geschuetzt"-Account.
      // Leitung darf NIEMALS löschen - keine Ausnahme.
      allow delete: if istAdmin() && !istUnantastbar();
    }

    /* ------------------------------------------------------------------
       usernames/{nameKleingeschrieben} — reserviert einen Benutzernamen,
       damit er nicht doppelt vergeben werden kann. Dokument enthält nur
       { uid }. Getrennt von "users", weil eine Verfügbarkeits-Prüfung per
       get() funktionieren muss, auch BEVOR man Verwalter oder überhaupt
       freigegeben ist (z. B. während der Registrierung selbst).
       ------------------------------------------------------------------ */
    match /usernames/{name} {
      // Jeder (auch nicht eingeloggt) darf prüfen, ob ein Name frei ist -
      // das Dokument enthält keine sensiblen Daten, nur eine UID.
      allow get: if true;

      // Niemand darf die komplette Namensliste auf einmal abfragen.
      allow list: if false;

      // Einen Namen reservieren: nur für die eigene UID (bei Registrierung)
      // oder durch einen Verwalter (z. B. beim direkten Anlegen eines
      // Kontos oder beim Umbenennen).
      allow create: if istEingeloggt() && (request.resource.data.uid == request.auth.uid || istAdmin());

      // Ein reserviertes Dokument wird nie "geändert", nur neu angelegt
      // oder gelöscht (siehe benenneUm in js/auth.js) - daher grundsätzlich
      // gesperrt.
      allow update: if false;

      // Freigeben (z. B. beim Umbenennen der alte Name, oder beim Löschen
      // eines Accounts): nur Verwalter.
      allow delete: if istAdmin();
    }

    /* ------------------------------------------------------------------
       adminLog/{logId} — Aktivitäts-Log für die Verwaltung. Ein Eintrag
       pro Verwalter-Aktion (Freigeben, Sperren, Rang ändern, Löschen, ...),
       geschrieben von js/auth.js. Absichtlich unveränderlich: einmal
       geschrieben, kann ein Eintrag NIE mehr geändert oder gelöscht werden
       (auch nicht von einem Verwalter) - sonst wäre das Log selbst nicht
       mehr vertrauenswürdig.
       ------------------------------------------------------------------ */
    match /adminLog/{logId} {
      allow create: if istAdmin();
      allow list, get: if istAdmin();
      allow update, delete: if false;
    }

    /* ------------------------------------------------------------------
       personalnotizen/{id} — interne RP-Leitungsnotizen zu einem Mitarbeiter
       (uid, text, erstelltVon, erstelltAm). Mehrere Einträge je Mitarbeiter,
       geschrieben von js/views/leitung-personal.js. Lesen/Erstellen: Leitung
       ODER Admin - AUSDRÜCKLICH NICHT über istFreigegeben(), damit normale
       Mitarbeiter diese Notizen nie sehen können, auch nicht über sich
       selbst. Ändern/Löschen bewusst nur Admin (Notizen bleiben für Leitung
       ein Verlauf, keine nachträglich korrigierbare Liste).
       ------------------------------------------------------------------ */
    match /personalnotizen/{id} {
      allow read, create: if istAdmin() || istLeitung();
      allow update, delete: if istAdmin();
    }

    /* ------------------------------------------------------------------
       ranghistorie/{id} — RP-Karrierehistorie (uid, alterRang, neuerRang,
       art, von, am, begruendung). Wird automatisch bei jeder Rangänderung
       geschrieben (siehe setzeRolle in js/auth.js), unabhängig davon, ob sie
       durch Admin oder Leitung ausgelöst wurde. Absichtlich unveränderlich
       wie adminLog - aber eine komplett eigene Collection, NICHT dasselbe
       technische Log. Lesen/Erstellen: Leitung ODER Admin, nie für normale
       Mitarbeiter.
       ------------------------------------------------------------------ */
    match /ranghistorie/{id} {
      allow read: if istAdmin() || istLeitung();
      allow create: if (istAdmin() || istLeitung())
                    && request.resource.data.uid is string
                    && request.resource.data.neuerRang is string;
      allow update, delete: if false;
    }

    /* ------------------------------------------------------------------
       raenge/{rangId} — PHASE 1 der Rang-Migration (siehe Konzept): zentrale
       Rangdefinitionen, Dokument-ID = stabile "rangId" (z. B. "notarzt"),
       die auch nach einer Umbenennung des Anzeigenamens unverändert bleibt.
       Ersetzt KÜNFTIG die hartkodierte BENUTZER_RAENGE-Liste - in dieser
       Phase liest/schreibt noch KEINE bestehende Funktion diese Collection,
       "users.rolle" bleibt unverändert der reine String wie bisher.

       Lesen: jeder freigegebene Nutzer (Ränge werden für Badges/Anzeigen in
       der normalen UI gebraucht, siehe rangBadgeHtml - keine sensiblen
       Daten). Schreiben (Erstellen/Bearbeiten): nur Admin - Leitung darf
       Ränge lesen, aber weder erstellen noch bearbeiten noch deaktivieren.
       Löschen ist bewusst UNMÖGLICH (nicht nur in der UI weggelassen,
       sondern hier hart verboten) - ein Rang wird ausschließlich über
       "aktiv: false" deaktiviert, nie entfernt, damit historische
       Ranghistorie-Einträge und bestehende Zuweisungen niemals ins Leere
       zeigen.
       ------------------------------------------------------------------ */
    match /raenge/{rangId} {
      allow read: if istFreigegeben();
      allow create, update: if istAdmin()
                            && request.resource.data.name is string
                            && request.resource.data.farbeToken in ['slate', 'cyan', 'teal', 'gruen', 'blau', 'violett', 'gold', 'orange', 'rot']
                            && request.resource.data.position is int
                            && request.resource.data.aktiv is bool;
      allow delete: if false;
    }

    /* ------------------------------------------------------------------
       presence/{dokument} — Online-Anzeige (Heartbeat je Browser-Tab).
       ------------------------------------------------------------------ */
    match /presence/{dokument} {
      allow read, write: if istFreigegeben();
    }

    /* ------------------------------------------------------------------
       Collections des Medical Department
       ------------------------------------------------------------------ */

    // Patienten: Profil (Name + Stammdaten) - jeder freigegebene Nutzer darf
    // Patienten anlegen, lesen und bearbeiten; LÖSCHEN darf nur ein Admin.
    match /patienten/{dokument} {
      allow read, create, update: if istFreigegeben();
      allow delete: if istAdmin();
    }

    // Akten: eine Behandlungs-Akte pro Dokument, referenziert ihren
    // Patienten über "patientId". Jeder freigegebene Nutzer darf Akten
    // anlegen, lesen, bearbeiten und löschen.
    match /akten/{dokument} {
      allow read, write: if istFreigegeben();
    }

    // Psychologische Gutachten (Waffenschein): ein Dokument pro Gutachten,
    // referenziert den Patienten über "patientId". Jeder freigegebene Nutzer
    // darf Gutachten anlegen, lesen und bearbeiten; LÖSCHEN darf nur ein Admin.
    match /gutachten/{dokument} {
      allow read, create, update: if istFreigegeben();
      allow delete: if istAdmin();
    }

    // Termine (MRT, CT, ...): ein Dokument pro Termin, verknüpft mit einem
    // Patienten ("patientId") oder mit einem frei eingetragenen Namen. Jeder
    // freigegebene Nutzer darf Termine anlegen, lesen, bearbeiten und löschen.
    match /termine/{dokument} {
      allow read, write: if istFreigegeben();
    }

    // Dienststatus der Leitstelle: ein Dokument je Person, Dokument-ID = die
    // feste "id" der Zeile in kataloge/mitarbeiterliste, Inhalt
    // { status, aktualisiertAm, von }. Jeder freigegebene Nutzer darf jeden
    // Status lesen und umstellen (Im Dienst / Außer Dienst); der Wert ist auf
    // die zwei erlaubten Status begrenzt. Löschen (Aufräumen) nur Verwalter.
    match /dienst/{id} {
      allow read: if istFreigegeben();
      allow create, update: if istFreigegeben()
                            && request.resource.data.status in ['im-dienst', 'ausser-dienst'];
      allow delete: if istAdmin();
    }

    // Info-Feld der Leitstelle (leitstelle/infos): ein kurzer gemeinsamer Text,
    // den jeder freigegebene Nutzer lesen und ändern darf (max. 600 Zeichen).
    match /leitstelle/{dokument} {
      allow read: if istFreigegeben();
      allow create, update: if istFreigegeben()
                            && request.resource.data.text is string
                            && request.resource.data.text.size() <= 600;
      allow delete: if istAdmin();
    }

    // Zugriffslinks: eine schreibgeschützte KOPIE einer Akte (nicht die Akte
    // selbst), die per Link auch ohne Konto lesbar ist. Die Dokument-ID ist ein
    // zufälliger, nicht erratbarer Schlüssel (>= 32 Zeichen). Einzelabruf
    // ("get") ist öffentlich, aber nur solange "laeuftAb" nicht überschritten
    // ist; Auflisten ("list", auch Abfragen) sowie alles Schreibende bleibt
    // freigegebenen Nutzern vorbehalten - ohne Link kann niemand diese
    // Dokumente finden.
    match /freigaben/{token} {
      allow get: if resource.data.laeuftAb > request.time;
      allow list: if istFreigegeben();
      allow create: if istFreigegeben() && token.size() >= 32;
      allow update, delete: if istFreigegeben();
    }

    // Verwaltete Kataloge (z. B. kataloge/leitfaeden, die admin-gepflegten
    // Behandlungsleitfäden): lesen dürfen alle freigegebenen Nutzer, ändern
    // nur Verwalter.
    match /kataloge/{dokument} {
      allow read: if istFreigegeben();
      allow write: if istAdmin();
    }
  }
}
